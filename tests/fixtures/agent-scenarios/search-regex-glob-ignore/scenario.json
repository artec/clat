{
  "schema_version": 1,
  "id": "search-regex-glob-ignore",
  "prompt": "Find the two Rust needle functions under src, respecting project ignore rules.",
  "model_steps": [
    {
      "expect": {
        "available_tools_include": ["search"]
      },
      "response": {
        "tool_calls": [
          {
            "id": "call-search",
            "name": "search",
            "arguments": {
              "query": "fn needle_(alpha|beta)",
              "path": ".",
              "mode": "regex",
              "include_globs": ["src/**/*.rs"],
              "extensions": ["rs"],
              "respect_gitignore": true,
              "max_results": 10
            }
          }
        ],
        "finish_reason": "tool_calls"
      }
    },
    {
      "expect": {
        "required_tool_results": ["search"],
        "required_tool_result_contains": [
          {"tool": "search", "text": "src/alpha.rs"},
          {"tool": "search", "text": "src/beta.rs"}
        ],
        "forbidden_tool_result_contains": [
          {"tool": "search", "text": "ignored.txt"},
          {"tool": "search", "text": "README.md"}
        ]
      },
      "response": {
        "text": "search complete",
        "finish_reason": "completed"
      }
    }
  ],
  "expected": {
    "outcome": "success",
    "event_kinds": [
      "run_started",
      "model_requested",
      "model_responded",
      "tool_requested",
      "permission_checked",
      "tool_started",
      "tool_finished",
      "model_requested",
      "model_stream",
      "model_responded",
      "run_completed"
    ],
    "durable_event_kinds": [
      "turn/start",
      "user/message",
      "step/start",
      "request/header",
      "assistant/message",
      "tool/call",
      "tool/result",
      "step/end",
      "step/start",
      "assistant/chunk",
      "assistant/message",
      "step/end",
      "turn/end"
    ],
    "permission_checks": [
      {"tool": "search", "decision": "allow"}
    ]
  }
}

