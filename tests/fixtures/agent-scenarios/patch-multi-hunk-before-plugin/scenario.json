{
  "schema_version": 1,
  "id": "patch-multi-hunk-before-plugin",
  "prompt": "Update both functions in demo.txt as one atomic patch.",
  "model_steps": [
    {
      "expect": {
        "available_tools_include": ["apply_patch"]
      },
      "response": {
        "tool_calls": [
          {
            "id": "call-apply-patch",
            "name": "apply_patch",
            "arguments": {
              "patch": "*** Begin Patch\n*** Update File: demo.txt\n@@\n fn alpha() -> i32 {\n-    1\n+    10\n }\n@@\n fn omega() -> i32 {\n-    2\n+    20\n }\n*** End Patch"
            }
          }
        ],
        "finish_reason": "tool_calls"
      }
    },
    {
      "expect": {
        "required_tool_results": ["apply_patch"]
      },
      "response": {
        "text": "patch complete",
        "finish_reason": "completed"
      }
    }
  ],
  "expected": {
    "outcome": "success",
    "event_kinds": [
      "run_started",
      "model_requested",
      "model_responded",
      "tool_requested",
      "permission_checked",
      "tool_started",
      "tool_finished",
      "model_requested",
      "model_stream",
      "model_responded",
      "run_completed"
    ],
    "durable_event_kinds": [
      "turn/start",
      "user/message",
      "step/start",
      "request/header",
      "assistant/message",
      "approval/asked",
      "approval/decided",
      "tool/call",
      "tool/result",
      "step/end",
      "step/start",
      "assistant/message",
      "step/end",
      "turn/end"
    ],
    "permission_checks": [
      {
        "tool": "apply_patch",
        "decision": "allow"
      }
    ]
  }
}
