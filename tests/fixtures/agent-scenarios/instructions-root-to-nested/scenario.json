{
  "schema_version": 1,
  "id": "instructions-root-to-nested",
  "prompt": "Read src/deep/file.rs, then finish.",
  "model_steps": [
    {
      "expect": {
        "available_tools_include": ["read_file"],
        "instructions_include": ["root-rule-token"],
        "instructions_exclude": ["nested-rule-token"]
      },
      "response": {
        "tool_calls": [
          {
            "id": "call-read-nested",
            "name": "read_file",
            "arguments": {"path": "src/deep/file.rs"}
          }
        ],
        "finish_reason": "tool_calls"
      }
    },
    {
      "expect": {
        "required_tool_results": ["read_file"],
        "instructions_include": ["root-rule-token", "nested-rule-token"]
      },
      "response": {
        "text": "instructions complete",
        "finish_reason": "completed"
      }
    }
  ],
  "expected": {
    "outcome": "success",
    "event_kinds": [
      "run_started",
      "model_requested",
      "model_responded",
      "tool_requested",
      "permission_checked",
      "tool_started",
      "tool_finished",
      "model_requested",
      "model_stream",
      "model_responded",
      "run_completed"
    ],
    "durable_event_kinds": [
      "turn/start",
      "user/message",
      "step/start",
      "request/header",
      "assistant/message",
      "tool/call",
      "tool/result",
      "step/end",
      "step/start",
      "request/header",
      "assistant/chunk",
      "assistant/message",
      "step/end",
      "turn/end"
    ],
    "permission_checks": [
      {"tool": "read_file", "decision": "allow"}
    ]
  }
}

