{
  "schema_version": 1,
  "id": "write-file-permission-control",
  "prompt": "Replace demo.txt with the requested content.",
  "model_steps": [
    {
      "expect": {
        "available_tools_include": ["write_file"]
      },
      "response": {
        "tool_calls": [
          {
            "id": "call-write-file",
            "name": "write_file",
            "arguments": {
              "path": "demo.txt",
              "content": "after\n"
            }
          }
        ],
        "finish_reason": "tool_calls"
      }
    },
    {
      "expect": {
        "required_tool_results": ["write_file"]
      },
      "response": {
        "text": "write complete",
        "finish_reason": "completed"
      }
    }
  ],
  "expected": {
    "outcome": "success",
    "event_kinds": [
      "run_started",
      "model_requested",
      "model_responded",
      "tool_requested",
      "permission_checked",
      "tool_started",
      "tool_finished",
      "model_requested",
      "model_stream",
      "model_responded",
      "run_completed"
    ],
    "durable_event_kinds": [
      "turn/start",
      "user/message",
      "step/start",
      "request/header",
      "assistant/message",
      "approval/asked",
      "approval/decided",
      "tool/call",
      "tool/result",
      "step/end",
      "step/start",
      "assistant/chunk",
      "assistant/message",
      "step/end",
      "turn/end"
    ],
    "permission_checks": [
      {
        "tool": "write_file",
        "decision": "allow"
      }
    ]
  }
}

